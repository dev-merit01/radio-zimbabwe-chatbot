# Copy to .env.providers on the SERVER only. Never share that file or commit it.
# Use start-connected.cmd to opt in. start-local.cmd ignores these credentials.
# Exact ngrok hostname only. The public host can access webhook routes, not the workspace.
WEBHOOK_PUBLIC_HOSTS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STATION=radio_zimbabwe
BIRD_ACCESS_KEY=
BIRD_WORKSPACE_ID=
# Optional: used only by the legacy reply client, not inbound vote reception.
BIRD_CHANNEL_ID=
# This is the only credential required for Bird receive-only mode.
BIRD_WEBHOOK_SECRET=
BIRD_STATION=radio_zimbabwe
ONEMSG_APP_KEY=
ONEMSG_AUTH_KEY=
ONEMSG_WEBHOOK_SECRET=
ONEMSG_STATION=radio_zimbabwe
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AUTO_AI_MATCH=False
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
