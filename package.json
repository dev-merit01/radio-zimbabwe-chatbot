{
  "name": "airvote",
  "private": true,
  "scripts": {
    "test:airvote": "node tests/browser/airvote.cjs",
    "test:browser": "node tests/browser/workspace.cjs",
    "desktop:dev": "tauri icon src-tauri/icons/airvote-icon.svg && tauri dev",
    "desktop:build": "tauri icon src-tauri/icons/airvote-icon.svg && tauri build --bundles nsis",
    "desktop:check": "node desktop/check.cjs && node --check desktop/ui/setup.js",
    "test:desktop-ui": "node tests/browser/desktop.cjs",
    "test:editions": "node tests/browser/editions.cjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "ajv": "8.20.0",
    "playwright": "1.62.1",
    "prettier": "3.8.1"
  }
}
